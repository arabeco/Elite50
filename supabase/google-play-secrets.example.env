# Supabase Edge Function secrets only.
# Set these with `npx supabase secrets set ... --project-ref xebhujvszurydytlrhra`.

GOOGLE_PLAY_PACKAGE_NAME="com.becoslab.elite2050"
GOOGLE_PLAY_ALLOWED_ORIGINS="https://elite2050.example.com,capacitor://localhost,ionic://localhost"

# Prefer the single JSON secret generated from the Google Cloud service account.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON='{"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"}'

# Alternative if you do not use GOOGLE_PLAY_SERVICE_ACCOUNT_JSON.
GOOGLE_PLAY_CLIENT_EMAIL="google-play-service-account@project.iam.gserviceaccount.com"
GOOGLE_PLAY_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
